// Exercises the shipped lib in src/cron.wyn via the tests/cron.wyn symlink.
import cron

test "interval to ms" { assert_eq(cron.cron_interval_ms(30), 30000) }
test "runs per hour" { assert_eq(cron.cron_runs_per_hour(60), 60) }
test "runs per hour 30s" { assert_eq(cron.cron_runs_per_hour(30), 120) }
test "runs per hour zero guard" { assert_eq(cron.cron_runs_per_hour(0), 0) }
test "runs per day" { assert_eq(cron.cron_runs_per_day(3600), 24) }
test "runs per day zero guard" { assert_eq(cron.cron_runs_per_day(0), 0) }
test "next run" { assert_eq(cron.cron_next_run_ms(1000000, 30000), 1030000) }
